{"content": "\"\"\"Tabular RL on FrozenLake-v1 -- Expected SARSA with a greedy refinement phase.\n\n    python train.py --seed SEED --out DIR --env-kwargs JSON [options]\n\nThe map is taken from --env-kwargs (e.g. {\"desc\": [...]}, {\"map_name\": \"4x4\"}),\nso the same code works for the default map and for unseen random maps.\n\nArtefacts written to DIR:\n    q.npy     -- float64 Q-table, shape (n_states, n_actions)\n    meta.json -- the map description and the hyper-parameters used\n\nNo pickle is used anywhere.\n\nMethod (tabular, numpy only)\n---------------------------\n* Expected SARSA control (Sutton & Barto, sec. 6.6) with an epsilon-greedy\n  behaviour policy:\n      Q(s,a) <- Q(s,a) + alpha [ r + gamma * sum_a' pi(a'|s') Q(s',a') - Q(s,a) ]\n* Three phases per learner, all sharing one table:\n    A) exploration    : epsilon 1.0 -> eps_end (linear), alpha = 0.1\n    B) refinement     : epsilon ~ 0.01, small alpha  -> removes the\n                        epsilon-soft bias of the phase-A values\n    C) polish         : epsilon ~ 0.005, alpha 0.01  -> nearly exact evaluation\n                        of the greedy policy that phases A/B produced\n* Several independent learners (different RNG seeds) are trained.  All\n  intermediate tables (A, B, C per learner) plus the mean of the C tables are\n  candidate policies; the one with the highest success rate measured on fresh\n  rollout episodes (common, i.e. paired, evaluation seeds) is saved.\n* A soft wall-clock guard skips later phases/learners if the budget runs low,\n  so a policy is always written well inside the time limit.\n\"\"\"\nimport argparse\nimport json\nimport os\nimport time\n\nimport numpy as np\nimport gymnasium as gym\n\n\n# ---------------------------------------------------------------- utilities\ndef make_env(env_kwargs, seed=None):\n    \"\"\"gymnasium FrozenLake; the seed only makes rollouts repeatable.\"\"\"\n    env = gym.make(\"FrozenLake-v1\", disable_env_checker=True, **env_kwargs)\n    if seed is not None:\n        env.reset(seed=int(seed))\n        env.action_space.seed(int(seed) + 1)\n    return env\n\n\ndef epsilon_at(ep, episodes, eps_start, eps_end, frac):\n    \"\"\"Linear decay eps_start -> eps_end over frac*episodes, then constant.\"\"\"\n    span = max(1.0, frac * episodes)\n    f = min(1.0, ep / span)\n    return eps_start + (eps_end - eps_start) * f\n\n\ndef td_target(Q, r, s2, term, eps, gamma, method, rng):\n    \"\"\"Bootstrap target for the three tabular methods (expected SARSA default).\"\"\"\n    if term:\n        return r\n    qrow = Q[s2]\n    nA = qrow.shape[0]\n    if method == \"tabular_q_learning\":\n        return r + gamma * qrow.max()\n    if method == \"sarsa\":\n        a2 = int(rng.integers(nA)) if rng.random() < eps else int(np.argmax(qrow))\n        return r + gamma * qrow[a2]\n    # expected_sarsa: expectation under the same epsilon-greedy policy\n    return r + gamma * ((1.0 - eps) * qrow.max() + (eps / nA) * qrow.sum())\n\n\ndef run_phase(env, Q, rng, episodes, alpha, gamma, method, eps_start, eps_end,\n              decay_frac, deadline=None):\n    \"\"\"epsilon-greedy control episodes; Q is updated in place.\"\"\"\n    nA = Q.shape[1]\n    for ep in range(episodes):\n        if deadline is not None and time.time() > deadline:\n            break\n        eps = epsilon_at(ep, episodes, eps_start, eps_end, decay_frac)\n        s, _ = env.reset()\n        s = int(s)\n        done = False\n        while not done:\n            if rng.random() < eps:\n                a = int(rng.integers(nA))\n            else:\n                a = int(np.argmax(Q[s]))\n            s2, r, term, trunc, _ = env.step(a)\n            s2 = int(s2)\n            target = td_target(Q, r, s2, term, eps, gamma, method, rng)\n            Q[s, a] += alpha * (target - Q[s, a])\n            s = s2\n            done = term or trunc\n\n\ndef train_one(env_kwargs, seed, args, deadline=None):\n    \"\"\"One learner; returns the tables after phases A, B and C.\"\"\"\n    env = make_env(env_kwargs, seed=seed)\n    Q = np.zeros((env.observation_space.n, env.action_space.n), dtype=np.float64)\n    rng = np.random.default_rng(seed)\n    run_phase(env, Q, rng, args.episodes, args.alpha, args.gamma, args.method,\n              args.eps_start, args.eps_end, args.decay_frac, deadline)\n    QA = Q.copy()\n    if args.refine_episodes > 0:\n        run_phase(env, Q, rng, args.refine_episodes, args.alpha_b, args.gamma,\n                  args.method, args.eps_b, args.eps_b, 1.0, deadline)\n    QB = Q.copy()\n    if args.polish_episodes > 0:\n        run_phase(env, Q, rng, args.polish_episodes, args.alpha_c, args.gamma,\n                  args.method, args.eps_c, args.eps_c, 1.0, deadline)\n    env.close()\n    return QA, QB, Q\n\n\ndef greedy_success(Q, env_kwargs, n=800, seed=50000):\n    \"\"\"Fraction of successful episodes for the greedy policy on Q.\"\"\"\n    env = make_env(env_kwargs, seed=seed)\n    wins = 0\n    for _ in range(n):\n        s, _ = env.reset()\n        done = False\n        while not done:\n            s, r, term, trunc, _ = env.step(int(np.argmax(Q[int(s)])))\n            s = int(s)\n            done = term or trunc\n            if term and r > 0:\n                wins += 1\n    env.close()\n    return wins / n\n\n\n# ---------------------------------------------------------------- main\ndef main():\n    p = argparse.ArgumentParser()\n    p.add_argument(\"--seed\", type=int, default=0)\n    p.add_argument(\"--out\", type=str, required=True)\n    p.add_argument(\"--env-kwargs\", type=str, default=\"{}\")\n    # phase A: exploration\n    p.add_argument(\"--episodes\", type=int, default=40000)\n    p.add_argument(\"--alpha\", type=float, default=0.1)\n    p.add_argument(\"--gamma\", type=float, default=0.99)\n    p.add_argument(\"--eps-start\", type=float, default=1.0)\n    p.add_argument(\"--eps-end\", type=float, default=0.05)\n    p.add_argument(\"--decay-frac\", type=float, default=0.4)\n    # phase B / C: greedy refinement and polish\n    p.add_argument(\"--refine-episodes\", type=int, default=20000)\n    p.add_argument(\"--alpha-b\", type=float, default=0.02)\n    p.add_argument(\"--eps-b\", type=float, default=0.01)\n    p.add_argument(\"--polish-episodes\", type=int, default=10000)\n    p.add_argument(\"--alpha-c\", type=float, default=0.01)\n    p.add_argument(\"--eps-c\", type=float, default=0.005)\n    # bookkeeping\n    p.add_argument(\"--learners\", type=int, default=3)\n    p.add_argument(\"--method\", type=str, default=\"expected_sarsa\")\n    p.add_argument(\"--select-episodes\", type=int, default=800)\n    p.add_argument(\"--max-train-seconds\", type=float, default=80.0)\n    args = p.parse_args()\n\n    env_kwargs = json.loads(args.env_kwargs) if args.env_kwargs else {}\n    env_kwargs.setdefault(\"is_slippery\", True)\n    if \"desc\" not in env_kwargs:\n        env_kwargs.setdefault(\"map_name\", \"4x4\")\n\n    os.makedirs(args.out, exist_ok=True)\n    t0 = time.time()\n    deadline = t0 + args.max_train_seconds\n\n    cands = {}\n    n_done = 0\n    for k in range(max(1, args.learners)):\n        if n_done >= 1 and time.time() > deadline:\n            print(f\"time guard: skipping learner {k}\")\n            break\n        tk = time.time()\n        QA, QB, QC = train_one(env_kwargs, args.seed + 1000 * k, args, deadline)\n        print(f\"learner {k}: {time.time()-tk:.1f}s\")\n        cands[f\"a{k}\"], cands[f\"b{k}\"], cands[f\"c{k}\"] = QA, QB, QC\n        n_done += 1\n    for tag, key in ((\"meanB\", \"b\"), (\"meanC\", \"c\")):\n        group = [k for k in cands if k.startswith(key)]\n        if len(group) > 1:\n            cands[tag] = np.mean(np.stack([cands[k] for k in sorted(group)], 0), 0)\n\n    # rollout-based policy selection with common (paired) evaluation seeds\n    scores = {}\n    for name in sorted(cands):\n        scores[name] = greedy_success(cands[name], env_kwargs,\n                                      n=args.select_episodes, seed=50000)\n        print(f\"select {name}: {scores[name]:.3f}\")\n    best_name = max(scores, key=lambda k: scores[k])\n    best_Q = cands[best_name]\n    print(f\"chosen={best_name} score={scores[best_name]:.3f}\")\n\n    np.save(os.path.join(args.out, \"q.npy\"), np.asarray(best_Q, dtype=np.float64))\n\n    desc = None\n    try:\n        tmp = make_env(env_kwargs)\n        desc = [\"\".join(map(str, row)) for row in tmp.unwrapped.desc]\n        tmp.close()\n    except Exception:\n        desc = None\n\n    meta = {\n        \"method\": args.method,\n        \"seed\": args.seed,\n        \"episodes\": args.episodes,\n        \"refine_episodes\": args.refine_episodes,\n        \"polish_episodes\": args.polish_episodes,\n        \"learners\": n_done,\n        \"alpha\": args.alpha,\n        \"alpha_b\": args.alpha_b,\n        \"alpha_c\": args.alpha_c,\n        \"gamma\": args.gamma,\n        \"eps_start\": args.eps_start,\n        \"eps_end\": args.eps_end,\n        \"eps_b\": args.eps_b,\n        \"eps_c\": args.eps_c,\n        \"decay_frac\": args.decay_frac,\n        \"chosen\": best_name,\n        \"scores\": {k: float(v) for k, v in scores.items()},\n        \"nS\": int(best_Q.shape[0]),\n        \"nA\": int(best_Q.shape[1]),\n        \"desc\": desc,\n        \"env_kwargs\": {k: v for k, v in env_kwargs.items() if k != \"desc\"},\n    }\n    with open(os.path.join(args.out, \"meta.json\"), \"w\") as f:\n        json.dump(meta, f, indent=2)\n    print(\"total train time %.1fs\" % (time.time() - t0))\n\n\nif __name__ == \"__main__\":\n    main()\n", "path": "train.py"}