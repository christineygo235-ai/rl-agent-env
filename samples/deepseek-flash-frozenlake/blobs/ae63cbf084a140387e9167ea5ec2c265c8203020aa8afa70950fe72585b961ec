class GreedyPolicy:
    def __init__(self, q):
        self.q = np.asarray(q, dtype=np.float64)
    def act(self, obs):
        s = int(obs) if not isinstance(obs, (int, np.integer)) else int(obs)
        return int(np.argmax(self.q[s]))

def load(path):
    q = np.load(os.path.join(path, "q.npy")) if os.path.isdir(path) else np.load(path)
    return GreedyPolicy(q)
