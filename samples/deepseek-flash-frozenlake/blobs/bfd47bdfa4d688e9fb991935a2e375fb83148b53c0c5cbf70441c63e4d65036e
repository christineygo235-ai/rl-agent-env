{"content": "\"\"\"Tabular RL on FrozenLake-v1: Expected SARSA (+ greedy refinement phase).\n\nUsage:\n    python train.py --seed SEED --out DIR --env-kwargs JSON [options]\n\nSaves DIR/q.npy (float64 Q-table) and DIR/meta.json (map + settings). No pickle.\n\nMethod\n------\nPhase A (exploration): Expected-SARSA control with an epsilon-greedy behaviour\npolicy, epsilon linearly annealed 1.0 -> eps_end and then held constant.\nPhase B (refinement):  continue updating the *same* table with a nearly greedy\npolicy (eps_b ~ 0.01) and a small step size, which turns the update into\non-policy evaluation of the greedy policy interleaved with greedy improvement\n(policy-iteration-like).  This removes the epsilon-soft bias from the Q-values\nand matters a lot on narrow maps where a single wrong action is fatal.\nSeveral independent learners are trained and the final table is picked by\nrollout-based policy selection (paired seeds) among all phase-A/phase-B tables\nand their mean.\n\"\"\"\nimport argparse\nimport json\nimport os\nimport time\n\nimport numpy as np\nimport gymnasium as gym\n\n\n# ---------------------------------------------------------------- utilities\ndef make_env(env_kwargs, seed=None):\n    env = gym.make(\"FrozenLake-v1\", disable_env_checker=True, **env_kwargs)\n    if seed is not None:\n        env.reset(seed=int(seed))\n        env.action_space.seed(int(seed) + 1)\n    return env\n\n\ndef epsilon_at(ep, episodes, eps_start, eps_end, frac):\n    \"\"\"Linear decay eps_start -> eps_end over frac*episodes, then constant.\"\"\"\n    span = max(1.0, frac * episodes)\n    f = min(1.0, ep / span)\n    return eps_start + (eps_end - eps_start) * f\n\n\ndef update(Q, s, a, r, s2, term, trunc, eps, gamma, alpha, method, rng):\n    \"\"\"One tabular TD update; returns nothing (Q modified in place).\"\"\"\n    if term:\n        target = r\n    else:\n        qrow = Q[s2]\n        if method == \"tabular_q_learning\":\n            target = r + gamma * qrow.max()\n        elif method == \"sarsa\":\n            if rng.random() < eps:\n                a2 = int(rng.integers(qrow.shape[0]))\n            else:\n                a2 = int(np.argmax(qrow))\n            target = r + gamma * qrow[a2]\n        else:  # expected_sarsa (default)\n            qmax = qrow.max()\n            target = r + gamma * ((1.0 - eps) * qmax\n                                  + (eps / qrow.shape[0]) * qrow.sum())\n    Q[s, a] += alpha * (target - Q[s, a])\n\n\ndef run_phase(env, Q, rng, episodes, alpha, gamma, method, eps_start, eps_end,\n              decay_frac):\n    \"\"\"Run `episodes` epsilon-greedy episodes in place; returns mean length.\"\"\"\n    nA = Q.shape[1]\n    steps = 0\n    for ep in range(episodes):\n        eps = epsilon_at(ep, episodes, eps_start, eps_end, decay_frac)\n        s, _ = env.reset()\n        s = int(s)\n        done = False\n        while not done:\n            if rng.random() < eps:\n                a = int(rng.integers(nA))\n            else:\n                a = int(np.argmax(Q[s]))\n            s2, r, term, trunc, _ = env.step(a)\n            s2 = int(s2)\n            update(Q, s, a, r, s2, term, trunc, eps, gamma, alpha, method, rng)\n            s = s2\n            done = term or trunc\n            steps += 1\n    return steps / max(1, episodes)\n\n\ndef train_one(env_kwargs, seed, episodes, alpha, gamma, eps_start, eps_end,\n              decay_frac, method, refine_episodes, alpha_b, eps_b):\n    \"\"\"One learner -> (Q_phaseA, Q_phaseB) with the same table carried over.\"\"\"\n    env = make_env(env_kwargs, seed=seed)\n    Q = np.zeros((env.observation_space.n, env.action_space.n), dtype=np.float64)\n    rng = np.random.default_rng(seed)\n    run_phase(env, Q, rng, episodes, alpha, gamma, method, eps_start, eps_end,\n              decay_frac)\n    QA = Q.copy()\n    if refine_episodes > 0:\n        run_phase(env, Q, rng, refine_episodes, alpha_b, gamma, method, eps_b,\n                  eps_b, 1.0)\n    env.close()\n    return QA, Q\n\n\ndef greedy_success(Q, env_kwargs, n=300, seed=99991):\n    \"\"\"Estimate greedy-policy success rate on fresh evaluation episodes.\"\"\"\n    env = make_env(env_kwargs, seed=seed)\n    wins = 0\n    for _ in range(n):\n        s, _ = env.reset()\n        done = False\n        while not done:\n            s, r, term, trunc, _ = env.step(int(np.argmax(Q[int(s)])))\n            s = int(s)\n            done = term or trunc\n            if term and r > 0:\n                wins += 1\n    env.close()\n    return wins / n\n\n\n# ---------------------------------------------------------------- main\ndef main():\n    p = argparse.ArgumentParser()\n    p.add_argument(\"--seed\", type=int, default=0)\n    p.add_argument(\"--out\", type=str, required=True)\n    p.add_argument(\"--env-kwargs\", type=str, default=\"{}\")\n    p.add_argument(\"--episodes\", type=int, default=40000)\n    p.add_argument(\"--learners\", type=int, default=3)\n    p.add_argument(\"--alpha\", type=float, default=0.1)\n    p.add_argument(\"--gamma\", type=float, default=0.99)\n    p.add_argument(\"--eps-start\", type=float, default=1.0)\n    p.add_argument(\"--eps-end\", type=float, default=0.05)\n    p.add_argument(\"--decay-frac\", type=float, default=0.4)\n    p.add_argument(\"--method\", type=str, default=\"expected_sarsa\")\n    p.add_argument(\"--refine-episodes\", type=int, default=20000)\n    p.add_argument(\"--alpha-b\", type=float, default=0.02)\n    p.add_argument(\"--eps-b\", type=float, default=0.01)\n    p.add_argument(\"--select-episodes\", type=int, default=600)\n    p.add_argument(\"--diag\", type=int, default=0)\n    args = p.parse_args()\n\n    env_kwargs = json.loads(args.env_kwargs) if args.env_kwargs else {}\n    env_kwargs.setdefault(\"is_slippery\", True)\n    env_kwargs.setdefault(\"map_name\", \"4x4\")\n\n    os.makedirs(args.out, exist_ok=True)\n    t0 = time.time()\n    n_learners = max(1, args.learners)\n    cands = {}\n    for k in range(n_learners):\n        tk = time.time()\n        QA, QB = train_one(env_kwargs, args.seed + 1000 * k, args.episodes,\n                           args.alpha, args.gamma, args.eps_start,\n                           args.eps_end, args.decay_frac, args.method,\n                           args.refine_episodes, args.alpha_b, args.eps_b)\n        print(f\"learner {k}: {time.time()-tk:.1f}s\")\n        cands[f\"a{k}\"] = QA\n        cands[f\"b{k}\"] = QB\n    if n_learners > 1:\n        cands[\"meanB\"] = np.mean(np.stack([cands[f\"b{k}\"]\n                                           for k in range(n_learners)], 0), 0)\n\n    # rollout-based policy selection with common (paired) evaluation seeds\n    scores = {}\n    for name, Q in cands.items():\n        scores[name] = greedy_success(Q, env_kwargs, n=args.select_episodes,\n                                      seed=50000)\n        print(f\"select {name}: {scores[name]:.3f}\")\n    best_name = max(scores, key=lambda k: scores[k])\n    best_Q = cands[best_name]\n    print(f\"chosen={best_name} score={scores[best_name]:.3f}\")\n\n    np.save(os.path.join(args.out, \"q.npy\"), np.asarray(best_Q, np.float64))\n\n    desc = None\n    try:\n        tmp = make_env(env_kwargs)\n        desc = [\"\".join(map(str, row)) for row in tmp.unwrapped.desc]\n        tmp.close()\n    except Exception:\n        desc = None\n\n    if args.diag:\n        _report_reference_dp(env_kwargs, best_Q, n=args.select_episodes)\n\n    meta = {\n        \"method\": args.method,\n        \"seed\": args.seed,\n        \"episodes\": args.episodes,\n        \"refine_episodes\": args.refine_episodes,\n        \"learners\": n_learners,\n        \"alpha\": args.alpha,\n        \"alpha_b\": args.alpha_b,\n        \"gamma\": args.gamma,\n        \"eps_start\": args.eps_start,\n        \"eps_end\": args.eps_end,\n        \"eps_b\": args.eps_b,\n        \"decay_frac\": args.decay_frac,\n        \"chosen\": best_name,\n        \"scores\": {k: float(v) for k, v in scores.items()},\n        \"nS\": int(best_Q.shape[0]),\n        \"nA\": int(best_Q.shape[1]),\n        \"desc\": desc,\n        \"env_kwargs\": {k: v for k, v in env_kwargs.items() if k != \"desc\"},\n    }\n    with open(os.path.join(args.out, \"meta.json\"), \"w\") as f:\n        json.dump(meta, f, indent=2)\n    print(\"total train time %.1fs\" % (time.time() - t0))\n\n\ndef _report_reference_dp(env_kwargs, Q, n=1000, seed=99991, gamma=0.99):\n    \"\"\"REPORTING ONLY: dynamic-programming reference on the true model.\n\n    It never influences the saved artefact; it is printed only so that the\n    learned policy can be compared with the optimum of the MDP.\n    \"\"\"\n    env = make_env(env_kwargs)\n    P = env.unwrapped.P\n    nS, nA = env.observation_space.n, env.action_space.n\n    V = np.zeros(nS)\n    for _ in range(50000):\n        d = 0.0\n        for s in range(nS):\n            best = -1e18\n            for a in range(nA):\n                q = 0.0\n                for p, s2, r, term in P[s][a]:\n                    q += p * (r + (0.0 if term else gamma * V[s2]))\n                best = max(best, q)\n            d = max(d, abs(best - V[s]))\n            V[s] = best\n        if d < 1e-13:\n            break\n    Qstar = np.zeros((nS, nA))\n    for s in range(nS):\n        for a in range(nA):\n            Qstar[s, a] = sum(p * (r + (0.0 if term else gamma * V[s2]))\n                              for p, s2, r, term in P[s][a])\n    opt = greedy_success(Qstar, env_kwargs, n=n, seed=seed)\n    agree = float(np.mean(np.argmax(Qstar, 1) == np.argmax(np.asarray(Q), 1)))\n    print(f\"[diag] DP-optimal success={opt:.3f} agreement={agree:.3f}\")\n    env.close()\n    return opt\n\n\nif __name__ == \"__main__\":\n    main()\n", "path": "train.py"}