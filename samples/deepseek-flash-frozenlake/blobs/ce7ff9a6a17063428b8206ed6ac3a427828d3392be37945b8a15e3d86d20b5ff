{"content": "\"\"\"Tabular RL on FrozenLake-v1 (Expected SARSA / Q-learning / SARSA).\n\nUsage:\n    python train.py --seed SEED --out DIR --env-kwargs JSON [options]\n\nSaves DIR/q.npy (Q-table, float32) and DIR/meta.json (map + settings). No pickle.\n\"\"\"\nimport argparse\nimport json\nimport os\nimport time\n\nimport numpy as np\nimport gymnasium as gym\n\n\n# ---------------------------------------------------------------- utilities\ndef make_env(env_kwargs, seed=None):\n    env = gym.make(\"FrozenLake-v1\", disable_env_checker=True, **env_kwargs)\n    if seed is not None:\n        env.reset(seed=int(seed))\n        env.action_space.seed(int(seed) + 1)\n    return env\n\n\ndef epsilon_at(ep, episodes, eps_start, eps_end, frac):\n    \"\"\"Linear decay eps_start -> eps_end over frac*episodes, then constant.\"\"\"\n    span = max(1.0, frac * episodes)\n    f = min(1.0, ep / span)\n    return eps_start + (eps_end - eps_start) * f\n\n\ndef train_one(env_kwargs, seed, episodes, alpha, gamma, eps_start, eps_end,\n              decay_frac, method):\n    \"\"\"One tabular learner.  Returns (Q, mean episode length).\"\"\"\n    env = make_env(env_kwargs, seed=seed)\n    nS = env.observation_space.n\n    nA = env.action_space.n\n    Q = np.zeros((nS, nA), dtype=np.float64)\n    rng = np.random.default_rng(seed)\n    steps = 0\n    for ep in range(episodes):\n        eps = epsilon_at(ep, episodes, eps_start, eps_end, decay_frac)\n        s, _ = env.reset()\n        s = int(s)\n        done = False\n        t = 0\n        while not done:\n            t += 1\n            if rng.random() < eps:\n                a = int(rng.integers(nA))\n            else:\n                a = int(np.argmax(Q[s]))\n            s2, r, term, trunc, _ = env.step(a)\n            s2 = int(s2)\n            if term:\n                target = r\n            else:\n                qrow = Q[s2]\n                if method == \"tabular_q_learning\":\n                    target = r + gamma * qrow.max()\n                elif method == \"sarsa\":\n                    if rng.random() < eps:\n                        a2 = int(rng.integers(nA))\n                    else:\n                        a2 = int(np.argmax(qrow))\n                    target = r + gamma * qrow[a2]\n                else:  # expected_sarsa (default)\n                    qmax = qrow.max()\n                    target = r + gamma * ((1.0 - eps) * qmax\n                                          + (eps / nA) * qrow.sum())\n            Q[s, a] += alpha * (target - Q[s, a])\n            s = s2\n            done = term or trunc\n        steps += t\n    env.close()\n    return Q, steps / max(1, episodes)\n\n\ndef greedy_success(Q, env_kwargs, n=300, seed=99991):\n    \"\"\"Estimate greedy-policy success rate with fresh evaluation episodes.\"\"\"\n    env = make_env(env_kwargs, seed=seed)\n    wins = 0\n    for _ in range(n):\n        s, _ = env.reset()\n        done = False\n        while not done:\n            s, r, term, trunc, _ = env.step(int(np.argmax(Q[int(s)])))\n            s = int(s)\n            done = term or trunc\n            if term and r > 0:\n                wins += 1\n    env.close()\n    return wins / n\n\n\n# ------------------------------------------------------- diagnostics (report)\ndef _report_reference_dp(env_kwargs, Q, n=1000, seed=99991, gamma=0.99):\n    \"\"\"REPORTING ONLY: value-iteration reference on the true model.\n\n    This never influences the saved artefact; it is only printed so that the\n    experiment can be compared against the optimum of the MDP.\n    \"\"\"\n    env = make_env(env_kwargs)\n    P = env.unwrapped.P\n    nS = env.observation_space.n\n    nA = env.action_space.n\n    V = np.zeros(nS)\n    for _ in range(20000):\n        d = 0.0\n        for s in range(nS):\n            best = -1e18\n            for a in range(nA):\n                q = 0.0\n                for p, s2, r, term in P[s][a]:\n                    q += p * (r + (0.0 if term else gamma * V[s2]))\n                best = max(best, q)\n            d = max(d, abs(best - V[s]))\n            V[s] = best\n        if d < 1e-12:\n            break\n    Qstar = np.zeros((nS, nA))\n    for s in range(nS):\n        for a in range(nA):\n            Qstar[s, a] = sum(p * (r + (0.0 if term else gamma * V[s2]))\n                              for p, s2, r, term in P[s][a])\n    opt_succ = greedy_success(Qstar, env_kwargs, n=n, seed=seed)\n    agree = float(np.mean(np.argmax(Qstar, 1) == np.argmax(Q, 1)))\n    env.close()\n    print(f\"[diag] DP-optimal success={opt_succ:.3f} policy_agreement={agree:.3f}\")\n    return opt_succ\n\n\n# ---------------------------------------------------------------- main\ndef main():\n    p = argparse.ArgumentParser()\n    p.add_argument(\"--seed\", type=int, default=0)\n    p.add_argument(\"--out\", type=str, required=True)\n    p.add_argument(\"--env-kwargs\", type=str, default=\"{}\")\n    p.add_argument(\"--episodes\", type=int, default=40000)\n    p.add_argument(\"--learners\", type=int, default=3)\n    p.add_argument(\"--alpha\", type=float, default=0.1)\n    p.add_argument(\"--gamma\", type=float, default=0.99)\n    p.add_argument(\"--eps-start\", type=float, default=1.0)\n    p.add_argument(\"--eps-end\", type=float, default=0.05)\n    p.add_argument(\"--decay-frac\", type=float, default=0.5)\n    p.add_argument(\"--method\", type=str, default=\"expected_sarsa\")\n    p.add_argument(\"--select-episodes\", type=int, default=600)\n    p.add_argument(\"--agg\", type=str, default=\"both\")  # best|mean|both\n    p.add_argument(\"--diag\", type=int, default=0)\n    args = p.parse_args()\n\n    env_kwargs = json.loads(args.env_kwargs) if args.env_kwargs else {}\n    env_kwargs.setdefault(\"is_slippery\", True)\n    env_kwargs.setdefault(\"map_name\", \"4x4\")\n\n    os.makedirs(args.out, exist_ok=True)\n    t0 = time.time()\n    n_learners = max(1, args.learners)\n    Qs = []\n    for k in range(n_learners):\n        tk = time.time()\n        Q, avglen = train_one(env_kwargs, args.seed + 1000 * k, args.episodes,\n                              args.alpha, args.gamma, args.eps_start,\n                              args.eps_end, args.decay_frac, args.method)\n        print(f\"learner {k}: {time.time()-tk:.1f}s avg_len={avglen:.1f}\")\n        Qs.append(Q)\n\n    cands = {}\n    for k, Q in enumerate(Qs):\n        cands[f\"l{k}\"] = Q\n    if n_learners > 1:\n        cands[\"mean\"] = np.mean(np.stack(Qs, 0), axis=0)\n\n    scores = {}\n    for name, Q in cands.items():\n        if name.startswith(\"l\") and n_learners > 1 and args.agg == \"mean\":\n            continue\n        if name == \"mean\" and args.agg == \"best\":\n            continue\n        n_eval = args.select_episodes if name != \"mean\" else 2 * args.select_episodes\n        scores[name] = greedy_success(Q, env_kwargs, n=n_eval, seed=50000)\n        print(f\"select {name}: {scores[name]:.3f}\")\n    best_name = max(scores, key=lambda k: scores[k])\n    best_Q = cands[best_name]\n    print(f\"chosen={best_name} score={scores[best_name]:.3f}\")\n    np.save(os.path.join(args.out, \"q.npy\"), best_Q.astype(np.float32))\n\n    desc = None\n    try:\n        tmp = make_env(env_kwargs)\n        desc = [\"\".join(map(str, row)) for row in tmp.unwrapped.desc]\n        tmp.close()\n    except Exception:\n        desc = None\n\n    if args.diag:\n        _report_reference_dp(env_kwargs, best_Q, n=args.select_episodes)\n\n    meta = {\n        \"method\": args.method,\n        \"seed\": args.seed,\n        \"episodes\": args.episodes,\n        \"learners\": n_learners,\n        \"alpha\": args.alpha,\n        \"gamma\": args.gamma,\n        \"eps_start\": args.eps_start,\n        \"eps_end\": args.eps_end,\n        \"decay_frac\": args.decay_frac,\n        \"chosen\": best_name,\n        \"nS\": int(best_Q.shape[0]),\n        \"nA\": int(best_Q.shape[1]),\n        \"desc\": desc,\n        \"env_kwargs\": {k: v for k, v in env_kwargs.items() if k != \"desc\"},\n    }\n    with open(os.path.join(args.out, \"meta.json\"), \"w\") as f:\n        json.dump(meta, f, indent=2)\n    print(\"total train time %.1fs\" % (time.time() - t0))\n\n\nif __name__ == \"__main__\":\n    main()\n", "path": "train.py"}