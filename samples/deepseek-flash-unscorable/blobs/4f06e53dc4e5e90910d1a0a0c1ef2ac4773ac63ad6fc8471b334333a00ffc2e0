import numpy as np

class GreedyPolicy:
    def __init__(self, q):
        self.q = np.asarray(q, dtype=np.float64)
    def act(self, obs):
        return int(np.argmax(self.q[int(obs)]))

def load(path):
    q = np.load(os.path.join(path, 'q.npy'))
    return GreedyPolicy(q)
